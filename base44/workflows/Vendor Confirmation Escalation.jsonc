{
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "vendor_escalation",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "escalate": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "escalateVendorConfirmation"
          },
          "then": "end",
          "x-base44": {
            "title": "Escalate overdue vendor confirmations"
          }
        }
      }
    ]
  },
  "name": "Vendor Confirmation Escalation",
  "description": "Escalates orders where the vendor has not confirmed within the deadline",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "*/30 * * * *",
      "one_time_date": null,
      "timezone": "UTC",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  }
}
{
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "auto_complete_orders",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "complete": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "autoCompleteOrder"
          },
          "then": "end",
          "x-base44": {
            "title": "Auto-complete delivered orders"
          }
        }
      }
    ]
  },
  "name": "Auto-Complete Orders",
  "description": "Automatically completes delivered orders with no open exceptions and creates settlement records",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "*/15 * * * *",
      "one_time_date": null,
      "timezone": "UTC",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  }
}
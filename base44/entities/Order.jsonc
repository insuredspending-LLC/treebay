{
  "name": "Order",
  "type": "object",
  "properties": {
    "order_number": {
      "type": "string"
    },
    "buyer_id": {
      "type": "string"
    },
    "vendor_id": {
      "type": "string",
      "description": "VendorProfile id"
    },
    "vendor_owner_id": {
      "type": "string"
    },
    "vendor_name": {
      "type": "string"
    },
    "quote_id": {
      "type": "string"
    },
    "rfq_id": {
      "type": "string"
    },
    "checkout_quote_id": {
      "type": "string",
      "description": "Authoritative financial snapshot"
    },
    "commerce_mode": {
      "type": "string",
      "enum": [
        "payments_disabled",
        "test",
        "live",
        "stripe_test"
      ],
      "default": "payments_disabled",
      "description": "Public checkout fails closed while payments are disabled. Test is restricted to approved testers/admins; live is real money. Legacy records without this field remain test history."
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "line_name": {
            "type": "string"
          },
          "quantity": {
            "type": "number"
          },
          "unit_price": {
            "type": "number"
          },
          "subtotal": {
            "type": "number"
          }
        }
      }
    },
    "subtotal": {
      "type": "number"
    },
    "delivery_charges": {
      "type": "number",
      "default": 0
    },
    "taxes": {
      "type": "number",
      "default": 0
    },
    "platform_fees": {
      "type": "number",
      "default": 0
    },
    "total": {
      "type": "number"
    },
    "total_cents": {
      "type": "number",
      "description": "Authoritative total in cents (mirror of CheckoutQuote)"
    },
    "fulfillment_method": {
      "type": "string",
      "enum": [
        "buyer_pickup",
        "vendor_delivery",
        "third_party_carrier",
        "pickup"
      ],
      "default": "buyer_pickup"
    },
    "destination_name": {
      "type": "string"
    },
    "destination_street": {
      "type": "string"
    },
    "destination_city": {
      "type": "string"
    },
    "destination_state": {
      "type": "string"
    },
    "destination_zip": {
      "type": "string"
    },
    "destination_instructions": {
      "type": "string"
    },
    "contact_name": {
      "type": "string"
    },
    "contact_phone": {
      "type": "string"
    },
    "requested_date": {
      "type": "string",
      "format": "date"
    },
    "payment_status": {
      "type": "string",
      "enum": [
        "pending",
        "authorized",
        "paid",
        "failed",
        "refunded",
        "partially_refunded",
        "disputed"
      ],
      "default": "pending"
    },
    "order_status": {
      "type": "string",
      "enum": [
        "draft",
        "pricing_confirmed",
        "awaiting_payment",
        "payment_confirmed",
        "inventory_reserved",
        "vendor_confirmed",
        "preparing",
        "ready_for_pickup",
        "delivery_assigned",
        "picked_up",
        "in_transit",
        "delivered",
        "completed",
        "settlement_pending",
        "settled",
        "payment_failed",
        "cancelled",
        "refund_pending",
        "refunded",
        "fulfillment_exception",
        "delivery_exception",
        "disputed"
      ],
      "default": "draft"
    },
    "reservation_expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "vendor_confirmed_at": {
      "type": "string",
      "format": "date-time"
    },
    "vendor_confirm_deadline": {
      "type": "string",
      "format": "date-time"
    },
    "delivered_at": {
      "type": "string",
      "format": "date-time"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    },
    "vendor_notes": {
      "type": "string"
    },
    "stripe_checkout_session_id": {
      "type": "string",
      "description": "Stripe Checkout Session id for the live buyer payment (live orders only)."
    },
    "stripe_payment_intent_id": {
      "type": "string",
      "description": "Stripe PaymentIntent id backing the live buyer payment."
    },
    "stripe_transfer_id": {
      "type": "string",
      "description": "Stripe Transfer id created at settlement to route seller proceeds to the connected account."
    },
    "stripe_transfer_reversed_cents": {
      "type": "number",
      "default": 0,
      "description": "Cumulative seller-transfer amount reversed at Stripe for refunds."
    },
    "stripe_transfer_reversal_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Stripe transfer reversal ids applied to this order."
    },
    "current_payment_attempt_id": {
      "type": "string",
      "description": "Current authoritative PaymentAttempt for live checkout."
    },
    "payment_attempt_sequence": {
      "type": "number",
      "default": 0
    },
    "buyer_confirmed_at": {
      "type": "string",
      "format": "date-time",
      "description": "Buyer-confirmed delivery/receipt timestamp."
    },
    "payout_eligible_at": {
      "type": "string",
      "format": "date-time",
      "description": "Earliest settlement time after the buyer-confirmation cooling hold."
    },
    "financial_hold": {
      "type": "boolean",
      "default": false,
      "description": "Blocks settlement/payout while a refund, dispute, reversal, or integrity issue needs resolution."
    },
    "financial_hold_reason": {
      "type": "string"
    },
    "stripe_dispute_id": {
      "type": "string"
    },
    "stripe_dispute_status": {
      "type": "string"
    }
  },
  "required": [
    "order_number",
    "buyer_id",
    "vendor_id",
    "vendor_owner_id",
    "total"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.buyer_id": "{{user.id}}"
        },
        {
          "data.vendor_owner_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
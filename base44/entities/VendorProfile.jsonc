{
  "name": "VendorProfile",
  "type": "object",
  "properties": {
    "owner_id": {
      "type": "string",
      "description": "Authenticated user id that owns this seller profile"
    },
    "business_name": {
      "type": "string"
    },
    "is_test_fixture": {
      "type": "boolean",
      "default": false,
      "description": "Internal test/demo seller record. Test fixtures are excluded from the public production marketplace."
    },
    "contact_name": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "address": {
      "type": "string"
    },
    "city": {
      "type": "string"
    },
    "state": {
      "type": "string"
    },
    "zip_code": {
      "type": "string"
    },
    "website": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "service_area": {
      "type": "string"
    },
    "pickup_available": {
      "type": "boolean",
      "default": true
    },
    "delivery_available": {
      "type": "boolean",
      "default": true
    },
    "wholesale_available": {
      "type": "boolean",
      "default": false
    },
    "seller_plan": {
      "type": "string",
      "enum": [
        "free",
        "professional",
        "business"
      ],
      "default": "free",
      "description": "Currently active seller entitlement; paid plans remain inactive during preview"
    },
    "seller_plan_status": {
      "type": "string",
      "enum": [
        "preview",
        "active",
        "past_due",
        "canceled",
        "inactive"
      ],
      "default": "preview"
    },
    "seller_billing_provider": {
      "type": "string",
      "enum": [
        "none",
        "stripe"
      ],
      "default": "none"
    },
    "requested_seller_plan": {
      "type": "string",
      "enum": [
        "free",
        "professional",
        "business"
      ],
      "default": "free",
      "description": "Founding-plan interest; does not grant paid access or create a charge"
    },
    "requested_plan_at": {
      "type": "string",
      "format": "date-time"
    },
    "seller_provider_customer_id": {
      "type": "string"
    },
    "seller_provider_subscription_id": {
      "type": "string"
    },
    "verification_status": {
      "type": "string",
      "enum": [
        "pending",
        "verified",
        "suspended"
      ],
      "default": "pending",
      "description": "Trust badge status. Pending does not block normal selling; verified may only be shown after TreEbay verification. The suspended value is retained for backward compatibility."
    },
    "selling_status": {
      "type": "string",
      "enum": [
        "active",
        "restricted",
        "suspended"
      ],
      "default": "active",
      "description": "Operational selling permission. New sellers activate automatically; only risk, policy, payout, or compliance exceptions should restrict or suspend selling."
    },
    "logo_url": {
      "type": "string"
    },
    "cover_url": {
      "type": "string"
    },
    "rating": {
      "type": "number",
      "default": 0
    },
    "review_count": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "business_name",
    "contact_name",
    "phone",
    "city",
    "state",
    "zip_code"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.owner_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
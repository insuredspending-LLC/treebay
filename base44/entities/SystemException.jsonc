{
  "name": "SystemException",
  "type": "object",
  "properties": {
    "severity": {
      "type": "string",
      "enum": [
        "INFO",
        "WARNING",
        "ACTION_REQUIRED",
        "CRITICAL"
      ]
    },
    "exception_type": {
      "type": "string"
    },
    "order_id": {
      "type": "string"
    },
    "shipment_id": {
      "type": "string"
    },
    "payment_id": {
      "type": "string"
    },
    "buyer_id": {
      "type": "string"
    },
    "vendor_id": {
      "type": "string"
    },
    "carrier_id": {
      "type": "string"
    },
    "reason": {
      "type": "string"
    },
    "technical_details_private": {
      "type": "string"
    },
    "recommended_action": {
      "type": "string"
    },
    "retry_count": {
      "type": "number",
      "default": 0
    },
    "max_retries": {
      "type": "number",
      "default": 3
    },
    "next_retry_at": {
      "type": "string",
      "format": "date-time"
    },
    "requires_admin": {
      "type": "boolean",
      "default": false
    },
    "status": {
      "type": "string",
      "enum": [
        "OPEN",
        "AUTO_RETRYING",
        "WAITING_ON_BUYER",
        "WAITING_ON_VENDOR",
        "WAITING_ON_CARRIER",
        "ADMIN_REVIEW",
        "RESOLVED",
        "CLOSED"
      ],
      "default": "OPEN"
    },
    "resolution": {
      "type": "string"
    },
    "resolved_at": {
      "type": "string",
      "format": "date-time"
    },
    "resolved_by": {
      "type": "string"
    }
  },
  "required": [
    "exception_type",
    "severity"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
{
  "name": "PaymentRecord",
  "type": "object",
  "properties": {
    "order_id": {
      "type": "string"
    },
    "buyer_id": {
      "type": "string"
    },
    "vendor_owner_id": {
      "type": "string"
    },
    "commerce_mode": {
      "type": "string",
      "enum": [
        "test",
        "live",
        "stripe_test"
      ],
      "default": "test",
      "description": "Test records never represent real money. Live records must be backed by a production payment provider."
    },
    "provider": {
      "type": "string",
      "default": "trebay_test"
    },
    "provider_payment_id": {
      "type": "string"
    },
    "amount": {
      "type": "number"
    },
    "amount_cents": {
      "type": "number"
    },
    "currency": {
      "type": "string",
      "default": "USD"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "authorized",
        "paid",
        "failed",
        "partially_refunded",
        "refunded",
        "disputed"
      ],
      "default": "pending"
    },
    "authorized_at": {
      "type": "string",
      "format": "date-time"
    },
    "paid_at": {
      "type": "string",
      "format": "date-time"
    },
    "failed_at": {
      "type": "string",
      "format": "date-time"
    },
    "refunded_amount": {
      "type": "number",
      "default": 0
    },
    "refund_status": {
      "type": "string",
      "enum": [
        "none",
        "pending",
        "partial",
        "full",
        "failed"
      ]
    },
    "provider_refund_id": {
      "type": "string"
    },
    "provider_refund_status": {
      "type": "string",
      "enum": [
        "none",
        "pending",
        "succeeded",
        "failed",
        "canceled"
      ],
      "default": "none"
    },
    "refunded_amount_cents": {
      "type": "number",
      "default": 0
    },
    "refund_failure_reason": {
      "type": "string"
    },
    "refund_last_event_at": {
      "type": "string",
      "format": "date-time"
    },
    "confirmation_status": {
      "type": "string",
      "enum": [
        "pending",
        "reconciling",
        "complete",
        "failed"
      ],
      "default": "pending"
    },
    "confirmation_completed_at": {
      "type": "string",
      "format": "date-time"
    },
    "transaction_ref": {
      "type": "string"
    },
    "metadata": {
      "type": "object"
    }
  },
  "required": [
    "order_id",
    "amount"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.buyer_id": "{{user.id}}"
        },
        {
          "data.vendor_owner_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
{
  "name": "TesterSignup",
  "type": "object",
  "properties": {
    "play_email": {
      "type": "string",
      "format": "email",
      "description": "Google email the tester uses with Google Play"
    },
    "status": {
      "type": "string",
      "enum": [
        "requested",
        "invited",
        "opted_in",
        "active",
        "completed",
        "declined"
      ],
      "default": "requested"
    },
    "consent_to_testing": {
      "type": "boolean",
      "default": false
    },
    "consent_at": {
      "type": "string",
      "format": "date-time"
    },
    "source": {
      "type": "string",
      "default": "public_website"
    },
    "invited_at": {
      "type": "string",
      "format": "date-time"
    },
    "opted_in_at": {
      "type": "string",
      "format": "date-time"
    },
    "testing_completed_at": {
      "type": "string",
      "format": "date-time"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "play_email",
    "consent_to_testing",
    "consent_at"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
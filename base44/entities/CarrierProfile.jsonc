{
  "name": "CarrierProfile",
  "type": "object",
  "properties": {
    "owner_id": {
      "type": "string",
      "description": "Authenticated user id that owns this carrier profile"
    },
    "business_name": {
      "type": "string"
    },
    "contact_name": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "address": {
      "type": "string"
    },
    "city": {
      "type": "string"
    },
    "state": {
      "type": "string"
    },
    "zip_code": {
      "type": "string"
    },
    "equipment_type": {
      "type": "string"
    },
    "service_radius": {
      "type": "string"
    },
    "operating_regions": {
      "type": "string"
    },
    "load_capabilities": {
      "type": "string"
    },
    "insurance_verified": {
      "type": "boolean",
      "default": false
    },
    "description": {
      "type": "string"
    },
    "verification_status": {
      "type": "string",
      "enum": [
        "pending",
        "verified",
        "suspended"
      ],
      "default": "pending"
    },
    "dot_number": {
      "type": "string"
    },
    "mc_number": {
      "type": "string"
    }
  },
  "required": [
    "business_name",
    "contact_name",
    "phone",
    "city",
    "state",
    "zip_code"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.owner_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
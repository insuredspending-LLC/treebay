{
  "name": "TaxCalculation",
  "type": "object",
  "properties": {
    "order_id": {
      "type": "string"
    },
    "checkout_quote_id": {
      "type": "string"
    },
    "commerce_mode": {
      "type": "string",
      "enum": [
        "test",
        "live"
      ],
      "default": "test",
      "description": "Test tax is an estimate only. Live tax must come from the configured production tax engine."
    },
    "provider": {
      "type": "string"
    },
    "jurisdiction": {
      "type": "string"
    },
    "taxable_amount_cents": {
      "type": "number"
    },
    "taxable_delivery_amount_cents": {
      "type": "number",
      "default": 0
    },
    "total_taxable_amount_cents": {
      "type": "number"
    },
    "tax_amount_cents": {
      "type": "number"
    },
    "rate": {
      "type": "number"
    },
    "calculation_reference": {
      "type": "string"
    },
    "collection_party": {
      "type": "string",
      "default": "trebay_test"
    },
    "remittance_responsibility": {
      "type": "string",
      "default": "trebay_test"
    },
    "status": {
      "type": "string",
      "enum": [
        "test_estimated",
        "not_configured",
        "calculated",
        "failed"
      ],
      "default": "test_estimated"
    }
  },
  "required": [
    "taxable_amount_cents",
    "tax_amount_cents"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
{
  "name": "MarketplaceFeeRule",
  "type": "object",
  "properties": {
    "rule_name": {
      "type": "string"
    },
    "transaction_type": {
      "type": "string",
      "enum": [
        "direct_listing",
        "accepted_quote",
        "all"
      ],
      "default": "all"
    },
    "percentage_fee": {
      "type": "number",
      "description": "Percentage of merchandise subtotal, e.g. 4 for 4%"
    },
    "flat_fee_cents": {
      "type": "number",
      "default": 0
    },
    "minimum_fee_cents": {
      "type": "number",
      "default": 0
    },
    "maximum_fee_cents": {
      "type": "number",
      "default": 0,
      "description": "0 = no cap"
    },
    "active": {
      "type": "boolean",
      "default": true
    },
    "effective_date": {
      "type": "string",
      "format": "date"
    }
  },
  "required": [
    "rule_name",
    "percentage_fee"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
{
  "name": "Project",
  "type": "object",
  "properties": {
    "buyer_id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "delivery_city": {
      "type": "string"
    },
    "delivery_state": {
      "type": "string"
    },
    "delivery_zip": {
      "type": "string"
    },
    "desired_delivery_date": {
      "type": "string",
      "format": "date"
    },
    "notes": {
      "type": "string"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "product_id": {
            "type": "string"
          },
          "common_name": {
            "type": "string"
          },
          "botanical_name": {
            "type": "string"
          },
          "quantity": {
            "type": "number"
          },
          "size_spec": {
            "type": "string"
          },
          "unit_price": {
            "type": "number"
          }
        }
      }
    }
  },
  "required": [
    "buyer_id",
    "name",
    "delivery_city",
    "delivery_state",
    "delivery_zip"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}
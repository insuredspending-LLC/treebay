{
  "name": "Favorite",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "target_type": {
      "type": "string",
      "enum": [
        "product",
        "vendor"
      ]
    },
    "target_id": {
      "type": "string"
    },
    "target_name": {
      "type": "string"
    }
  },
  "required": [
    "user_id",
    "target_type",
    "target_id"
  ],
  "rls": {
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}
{
  "name": "RFQ",
  "type": "object",
  "properties": {
    "buyer_id": {
      "type": "string"
    },
    "project_id": {
      "type": "string"
    },
    "delivery_city": {
      "type": "string"
    },
    "delivery_state": {
      "type": "string"
    },
    "delivery_zip": {
      "type": "string"
    },
    "requested_delivery_date": {
      "type": "string",
      "format": "date"
    },
    "quote_deadline": {
      "type": "string",
      "format": "date"
    },
    "notes": {
      "type": "string"
    },
    "substitution_allowed": {
      "type": "boolean",
      "default": false
    },
    "delivery_required": {
      "type": "boolean",
      "default": true
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "open",
        "quotes_received",
        "checkout_pending",
        "awarded",
        "closed",
        "cancelled"
      ],
      "default": "open"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "common_name": {
            "type": "string"
          },
          "botanical_name": {
            "type": "string"
          },
          "quantity": {
            "type": "number"
          },
          "size_spec": {
            "type": "string"
          },
          "notes": {
            "type": "string"
          }
        }
      }
    }
  },
  "required": [
    "buyer_id",
    "delivery_city",
    "delivery_state",
    "delivery_zip"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}
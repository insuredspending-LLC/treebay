{
  "name": "Shipment",
  "type": "object",
  "properties": {
    "order_id": {
      "type": "string"
    },
    "buyer_id": {
      "type": "string"
    },
    "vendor_owner_id": {
      "type": "string"
    },
    "pickup_location": {
      "type": "string"
    },
    "delivery_location": {
      "type": "string"
    },
    "pickup_window": {
      "type": "string"
    },
    "delivery_window": {
      "type": "string"
    },
    "cargo_description": {
      "type": "string"
    },
    "estimated_weight": {
      "type": "string"
    },
    "estimated_dimensions": {
      "type": "string"
    },
    "equipment_requirement": {
      "type": "string"
    },
    "shipment_status": {
      "type": "string",
      "enum": [
        "pending",
        "quoted",
        "assigned",
        "pickup_scheduled",
        "picked_up",
        "in_transit",
        "delivered",
        "confirmed",
        "pickup_delayed",
        "delivery_delayed",
        "damaged",
        "delivery_failed",
        "cancelled",
        "exception"
      ],
      "default": "pending"
    },
    "carrier_id": {
      "type": "string"
    },
    "freight_quote_id": {
      "type": "string"
    },
    "delivery_method": {
      "type": "string",
      "enum": [
        "buyer_pickup",
        "vendor_delivery",
        "third_party_carrier"
      ]
    },
    "delivery_price_cents": {
      "type": "number"
    },
    "delivery_timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "receiver_name": {
      "type": "string"
    },
    "delivery_notes": {
      "type": "string"
    },
    "proof_of_delivery_url": {
      "type": "string"
    },
    "confirmation_code": {
      "type": "string"
    },
    "buyer_confirmed": {
      "type": "boolean",
      "default": false
    },
    "carrier_confirmed": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "order_id",
    "pickup_location",
    "delivery_location"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.buyer_id": "{{user.id}}"
        },
        {
          "data.vendor_owner_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
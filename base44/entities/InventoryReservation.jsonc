{
  "name": "InventoryReservation",
  "type": "object",
  "properties": {
    "order_id": {
      "type": "string"
    },
    "checkout_quote_id": {
      "type": "string"
    },
    "product_id": {
      "type": "string"
    },
    "buyer_id": {
      "type": "string"
    },
    "vendor_id": {
      "type": "string"
    },
    "quantity": {
      "type": "integer",
      "minimum": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "reserving",
        "reserved",
        "committing",
        "committed",
        "releasing",
        "reversing",
        "released",
        "expired"
      ],
      "default": "reserving"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "reserved_at": {
      "type": "string",
      "format": "date-time"
    },
    "committed_at": {
      "type": "string",
      "format": "date-time"
    },
    "released_at": {
      "type": "string",
      "format": "date-time"
    },
    "release_reason": {
      "type": "string"
    }
  },
  "required": [
    "order_id",
    "product_id",
    "quantity"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.buyer_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
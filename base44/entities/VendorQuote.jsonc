{
  "name": "VendorQuote",
  "type": "object",
  "properties": {
    "rfq_id": {
      "type": "string"
    },
    "vendor_id": {
      "type": "string",
      "description": "VendorProfile id"
    },
    "vendor_owner_id": {
      "type": "string"
    },
    "vendor_name": {
      "type": "string"
    },
    "vendor_city": {
      "type": "string"
    },
    "vendor_state": {
      "type": "string"
    },
    "buyer_id": {
      "type": "string"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "line_name": {
            "type": "string"
          },
          "quantity_offered": {
            "type": "number"
          },
          "unit_price": {
            "type": "number"
          },
          "subtotal": {
            "type": "number"
          },
          "availability": {
            "type": "string"
          },
          "estimated_ready_date": {
            "type": "string",
            "format": "date"
          },
          "delivery_offered": {
            "type": "boolean",
            "default": false
          },
          "delivery_price": {
            "type": "number"
          },
          "taxes": {
            "type": "number"
          },
          "additional_fees": {
            "type": "number"
          },
          "substitution_details": {
            "type": "string"
          }
        }
      }
    },
    "quote_total": {
      "type": "number"
    },
    "expiration_date": {
      "type": "string",
      "format": "date"
    },
    "vendor_notes": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "submitted",
        "revised",
        "accepted",
        "declined",
        "expired",
        "withdrawn"
      ],
      "default": "submitted"
    }
  },
  "required": [
    "rfq_id",
    "vendor_id",
    "vendor_owner_id",
    "buyer_id"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.buyer_id": "{{user.id}}"
        },
        {
          "data.vendor_owner_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "$or": [
        {
          "data.vendor_owner_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}